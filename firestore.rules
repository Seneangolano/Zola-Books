rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User sync data (purchases, favorites, reading progress, bookmarks)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Health / Connection test doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}

